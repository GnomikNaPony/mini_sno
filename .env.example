# Local open model (default). Install Ollama and run: ollama pull qwen3.5:9b
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.45

# Optional paid fallback: set AI_PROVIDER=openai and add a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=low

# Enable only when serving over HTTPS.
COOKIE_SECURE=false
# Optional comma-separated email allowlist; empty = open registration.
ALLOWED_EMAILS=
# DATA_DIR=./data
