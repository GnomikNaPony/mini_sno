# Optional: without a key, the app produces a source-based digest.
OPENAI_API_KEY=
# Pinned model version: rationale and prices in docs/AI_MODEL.md.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# For older models such as gpt-4.1-mini, leave this value empty.
OPENAI_REASONING_EFFORT=low
# Enable only when serving over HTTPS.
COOKIE_SECURE=false
# Optional comma-separated email allowlist; empty = open registration.
ALLOWED_EMAILS=
# DATA_DIR=./data
